<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane id="loginRootPane" prefHeight="800.0" prefWidth="1200.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.zeki.employeecontrol.controller.scene.SearchUserViewController">
   <top>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="model-label-L" text="Employee supervisor 2026" />
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </HBox>
   </top>
   <bottom>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="300.0" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="model-label-S" text="Desarrollado por Ezequiel Tamayo" />
            <Label styleClass="model-label-S" text="Versión: 1.0.0" />
         </children>
         <BorderPane.margin>
            <Insets left="400.0" />
         </BorderPane.margin>
      </HBox>
   </bottom>
   <center>
      <VBox id="loginBox" alignment="CENTER" maxHeight="500.0" maxWidth="500.0" prefHeight="600.0" prefWidth="500.0" spacing="30.0" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER" spacing="20.0">
               <children>
                  <Label styleClass="model-label-M" text="Buscar empleado">
                     <padding>
                        <Insets left="30.0" right="30.0" top="20.0" />
                     </padding>
                  </Label>
                  <TextField fx:id="dniField" alignment="CENTER" layoutX="10.0" layoutY="91.0" prefHeight="30.0" prefWidth="150.0" promptText="Introduce Dni">
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </TextField>
                  <VBox fx:id="UserDataBox" spacing="30.0" visible="false">
                     <children>
                        <HBox alignment="CENTER" spacing="5.0">
                           <children>
                              <Label styleClass="model-label-S" text="Nombre: " />
                              <Label fx:id="nameLabel" layoutX="143.0" layoutY="10.0" styleClass="model-label-S" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER" layoutX="10.0" layoutY="10.0" spacing="5.0">
                           <children>
                              <Label styleClass="model-label-S" text="Apellido:" />
                              <Label fx:id="lastNameLabel" layoutX="143.0" layoutY="10.0" styleClass="model-label-S" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER" layoutX="10.0" layoutY="72.0" spacing="5.0">
                           <children>
                              <Label styleClass="model-label-S" text="Dni:" />
                              <Label fx:id="dniLabel" layoutX="143.0" layoutY="10.0" styleClass="model-label-S" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER" layoutX="10.0" layoutY="134.0" spacing="5.0">
                           <children>
                              <Label styleClass="model-label-S" text="Email:" />
                              <Label fx:id="emailLabel" layoutX="143.0" layoutY="10.0" styleClass="model-label-S" />
                           </children>
                        </HBox>
                     </children></VBox>
               </children>
            </VBox>
            <Label fx:id="feedBackLabel" styleClass="feedback-label" text="Este es el texto feedback" wrapText="true">
               <font>
                  <Font name="Segoe UI" size="12.0" />
               </font>
            </Label>
            <VBox alignment="CENTER">
               <children>
                  <HBox alignment="CENTER" fillHeight="false" prefHeight="100.0" prefWidth="200.0" spacing="30.0">
                     <children>
                        <Button fx:id="searchBtn" mnemonicParsing="false" styleClass="model-ButtonA" text="Buscar" />
                        <Button fx:id="clearBtn" mnemonicParsing="false" styleClass="model-ButtonA" text="Limpiar" />
                        <Button fx:id="goBackBtn" mnemonicParsing="false" styleClass="model-ButtonA" text="Regresar" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="30.0" left="80.0" right="80.0" top="10.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
