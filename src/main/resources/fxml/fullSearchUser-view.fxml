<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane id="loginRootPane" prefHeight="800.0" prefWidth="1200.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.zeki.employeecontrol.controller.scene.FullSearchUserViewController">
   <top>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="model-label-L" text="Employee supervisor 2026" />
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </HBox>
   </top>
   <bottom>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="300.0" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="model-label-S" text="Desarrollado por Ezequiel Tamayo" />
            <Label styleClass="model-label-S" text="Versión: 1.0.0" />
         </children>
         <BorderPane.margin>
            <Insets left="400.0" />
         </BorderPane.margin>
      </HBox>
   </bottom>
   <center>
      <VBox id="loginBox" alignment="CENTER" maxHeight="500.0" maxWidth="800.0" prefHeight="600.0" prefWidth="800.0" spacing="30.0" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER" spacing="20.0">
               <children>
                  <Label styleClass="model-label-M" text="Lista de empleados">
                     <padding>
                        <Insets left="30.0" right="30.0" top="20.0" />
                     </padding>
                  </Label>
                  <TableView fx:id="usersTable" styleClass="personalTable">
                    <columns>
                      <TableColumn fx:id="nameColumn" minWidth="100.0" prefWidth="-1.0" text="Nombre" />
                      <TableColumn fx:id="lastNameColumn" minWidth="100.0" prefWidth="-1.0" text="Apellido" />
                        <TableColumn fx:id="dniColumn" minWidth="100.0" prefWidth="-1.0" text="Dni" />
                        <TableColumn fx:id="emailColumn" minWidth="100.0" prefWidth="-1.0" text="Email" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
            <Label fx:id="feedBackLabel" alignment="CENTER" minHeight="35.0" prefHeight="35.0" styleClass="feedback-label" text="Este es el texto feedback" visible="false" wrapText="true">
               <font>
                  <Font name="Segoe UI" size="12.0" />
               </font>
            </Label>
            <VBox alignment="CENTER">
               <children>
                  <HBox alignment="CENTER" fillHeight="false" prefHeight="100.0" prefWidth="200.0" spacing="30.0">
                     <children>
                        <Button fx:id="searchBtn" mnemonicParsing="false" styleClass="model-ButtonA" text="Buscar" />
                        <Button fx:id="goBackBtn" mnemonicParsing="false" styleClass="model-ButtonA" text="Regresar" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="30.0" left="50.0" right="50.0" top="10.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
