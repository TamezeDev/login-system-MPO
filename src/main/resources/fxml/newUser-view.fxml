<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane id="loginRootPane" prefHeight="800.0" prefWidth="1200.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.zeki.employeecontrol.controller.scene.newUserViewController">
   <top>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="model-label-L" text="Employee supervisor 2026" />
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </HBox>
   </top>
   <bottom>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="300.0" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="model-label-S" text="Desarrollado por Ezequiel Tamayo" />
            <Label styleClass="model-label-S" text="Versión: 1.0.0" />
         </children>
         <BorderPane.margin>
            <Insets left="400.0" />
         </BorderPane.margin>
      </HBox>
   </bottom>
   <center>
      <VBox id="loginBox" alignment="CENTER" maxHeight="500.0" maxWidth="500.0" prefHeight="600.0" prefWidth="500.0" spacing="30.0" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER" spacing="20.0">
               <children>
                  <Label styleClass="model-label-M" text="Datos del nuevo empleado:">
                     <padding>
                        <Insets left="30.0" right="30.0" top="20.0" />
                     </padding></Label>
                  <ComboBox fx:id="userTypeCombo" prefWidth="150.0" styleClass="model-ComboBoxA" />
                  <TextField fx:id="nameField" prefHeight="30.0" prefWidth="150.0" promptText="Nombre">
                     <padding>
                        <Insets left="10.0" top="30.0" />
                     </padding>
                  </TextField>
                  <TextField fx:id="lastNameField" layoutX="10.0" layoutY="56.0" prefHeight="30.0" prefWidth="150.0" promptText="Apellido">
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </TextField>
                  <TextField fx:id="dniField" layoutX="10.0" layoutY="91.0" prefHeight="30.0" prefWidth="150.0" promptText="Dni">
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </TextField>
                  <TextField fx:id="emailField" layoutX="10.0" layoutY="126.0" prefHeight="30.0" prefWidth="150.0" promptText="Email">
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </TextField>
                  <PasswordField fx:id="passField" prefHeight="30.0" prefWidth="150.0" promptText="Contraseña">
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </PasswordField>
               </children>
               <VBox.margin>
                  <Insets bottom="20.0" />
               </VBox.margin>
            </VBox>
            <Label fx:id="feedBackLabel" alignment="CENTER" minHeight="35.0" prefHeight="35.0" styleClass="feedback-label" text="Este es el texto feedback" visible="false" wrapText="true">
               <font>
                  <Font name="Segoe UI" size="12.0" />
               </font>
            </Label>
            <VBox alignment="CENTER">
               <children>
                  <HBox alignment="CENTER" fillHeight="false" prefHeight="100.0" prefWidth="200.0" spacing="30.0">
                     <children>
                        <Button fx:id="registerBtn" mnemonicParsing="false" styleClass="model-ButtonA" text="Registrar" />
                        <Button fx:id="clearBtn" mnemonicParsing="false" styleClass="model-ButtonA" text="Limpiar" />
                        <Button fx:id="goBackBtn" mnemonicParsing="false" styleClass="model-ButtonA" text="Regresar" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="30.0" left="80.0" right="80.0" top="10.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
